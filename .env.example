# Frontend environment variables
# For local dev, no build step needed, just serve it via a live server.
# For production (Render static site):
# The build command injects BACKEND_URL into index.html:
# BACKEND_URL=https://your-backend-app.onrender.com

# Backend environment variables
# For local dev:
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# For production:
# FRONTEND_URL=https://your-frontend-app.onrender.com

# PORT is automatically injected by Render
# PORT=8000
